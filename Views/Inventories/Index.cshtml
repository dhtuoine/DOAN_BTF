@model IEnumerable<DOAN_BTF.Models.Inventory>

@{
    ViewData["Title"] = "Quản lý kho";

    int totalStock = Model.Sum(x => x.Quantity ?? 0);
    int lowStock = Model.Count(x => (x.Quantity ?? 0) <= 5 && (x.Quantity ?? 0) > 0);
    int outStock = Model.Count(x => (x.Quantity ?? 0) == 0);
    int totalItems = Model.Count();
}

<div class="p-6 space-y-6">

    <div class="flex justify-end gap-3">
        <a asp-action="Create"
           class="flex items-center gap-2 px-5 py-3 rounded-2xl bg-[#031635] text-white text-sm font-bold shadow-md hover:shadow-xl hover:scale-[1.02] transition-all duration-300">
            <span class="material-symbols-outlined text-[20px]">add_circle</span>
            Nhập phôi áo
        </a>

        <a asp-action="Logs"
           class="flex items-center gap-2 px-5 py-3 rounded-2xl bg-white border border-slate-200 text-slate-700 text-sm font-bold hover:bg-slate-50 transition-all">
            <span class="material-symbols-outlined text-[20px]">history</span>
            Lịch sử giao dịch kho
        </a>
    </div>

    <!-- STATS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6">

        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="flex justify-between items-start mb-5">
                <div>
                    <p class="text-slate-400 text-xs font-bold uppercase tracking-wider">
                        Phân loại phôi
                    </p>

                    <h2 class="text-4xl font-black tracking-tight text-[#031635] mt-2">
                        @totalItems
                    </h2>
                </div>

                <div class="w-12 h-12 rounded-2xl bg-slate-50 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[#031635]">
                        inventory
                    </span>
                </div>
            </div>

            <div class="h-2 rounded-full bg-slate-100 overflow-hidden">
                <div class="h-full bg-[#031635] w-full rounded-full"></div>
            </div>
        </div>

        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="flex justify-between items-start mb-5">
                <div>
                    <p class="text-slate-400 text-xs font-bold uppercase tracking-wider">
                        Tổng phôi trong kho
                    </p>

                    <h2 class="text-4xl font-black tracking-tight text-[#031635] mt-2">
                        @totalStock
                    </h2>
                </div>

                <div class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center">
                    <span class="material-symbols-outlined text-blue-600">
                        warehouse
                    </span>
                </div>
            </div>

            <div class="h-2 rounded-full bg-slate-100 overflow-hidden">
                <div class="h-full bg-blue-600 w-full rounded-full"></div>
            </div>
        </div>

        <div class="bg-amber-50 rounded-3xl p-6 border border-amber-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="flex justify-between items-start mb-5">
                <div>
                    <p class="text-amber-600 text-xs font-bold uppercase tracking-wider">
                        Sắp hết hàng
                    </p>

                    <h2 class="text-4xl font-black tracking-tight text-amber-600 mt-2">
                        @lowStock
                    </h2>
                </div>

                <div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center">
                    <span class="material-symbols-outlined text-amber-500">
                        warning
                    </span>
                </div>
            </div>

            <div class="h-2 rounded-full bg-amber-100 overflow-hidden">
                <div class="h-full bg-amber-500 rounded-full @(lowStock > 0 ? "w-1/2" : "w-0")"></div>
            </div>
        </div>

        <div class="bg-red-50 rounded-3xl p-6 border border-red-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="flex justify-between items-start mb-5">
                <div>
                    <p class="text-red-500 text-xs font-bold uppercase tracking-wider">
                        Đã hết hàng
                    </p>

                    <h2 class="text-4xl font-black tracking-tight text-red-500 mt-2">
                        @outStock
                    </h2>
                </div>

                <div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center">
                    <span class="material-symbols-outlined text-red-500">
                        error
                    </span>
                </div>
            </div>

            <div class="h-2 rounded-full bg-red-100 overflow-hidden">
                <div class="h-full bg-red-500 rounded-full @(outStock > 0 ? "w-full" : "w-0")"></div>
            </div>
        </div>
    </div>

    <!-- FILTER -->
    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5">

        <form method="get"
              asp-action="Index"
              class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">

            <div>
                <label class="block text-xs font-bold text-slate-500 mb-2">
                    LỌC SẢN PHẨM
                </label>

                <select name="search"
                        class="w-full px-4 py-3 rounded-2xl border border-slate-200 bg-white focus:ring-2 focus:ring-blue-100 outline-none">

                    <option value="">Tất cả sản phẩm</option>

                    @foreach (var item in ViewBag.Products)
                    {
                        <option value="@item.ProductName"
                                selected="@(ViewBag.Search == item.ProductName)">
                            @item.ProductName
                        </option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-500 mb-2">
                    LỌC MÀU
                </label>

                <select name="color"
                        class="w-full px-4 py-3 rounded-2xl border border-slate-200">

                    <option value="">Tất cả màu</option>

                    @foreach (var c in ViewBag.Colors)
                    {
                        <option value="@c"
                                selected="@(ViewBag.SelectedColor == c)">
                            @c
                        </option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-500 mb-2">
                    LỌC SIZE
                </label>

                <select name="size"
                        class="w-full px-4 py-3 rounded-2xl border border-slate-200">

                    <option value="">Tất cả size</option>

                    @foreach (var s in ViewBag.Sizes)
                    {
                        <option value="@s"
                                selected="@(ViewBag.SelectedSize == s)">
                            @s
                        </option>
                    }
                </select>
            </div>

            <div class="flex gap-2">
                <button type="submit"
                        class="px-6 py-3 rounded-2xl bg-[#031635] text-white font-bold shadow-md hover:shadow-xl hover:scale-[1.02] active:scale-95 transition-all duration-300">
                    Áp dụng
                </button>

                <a asp-action="Index"
                   class="px-5 py-3 rounded-2xl border border-slate-300 hover:bg-slate-50 transition-all">
                    Xóa
                </a>
            </div>
        </form>
    </div>

    <!-- TABLE -->
    <div class="bg-white rounded-[28px] border border-slate-100 shadow-sm overflow-hidden">

        <div class="px-8 py-6 border-b border-slate-100 flex items-center justify-between">
            <div>
                <h2 class="text-xl font-black text-slate-800">
                    Danh sách tồn kho
                </h2>

                <p class="text-sm text-slate-400 mt-1">
                    Theo dõi số lượng phôi áo hiện có trong kho
                </p>
            </div>
        </div>

        <div class="overflow-x-auto">

            <table class="w-full text-left border-collapse text-sm">

                <thead class="sticky top-0 z-10 bg-slate-50 border-b border-slate-100 text-xs font-bold text-slate-400 uppercase tracking-wider">
                    <tr>
                        <th class="py-4 px-5">STT</th>
                        <th class="px-6 py-4">Sản phẩm</th>
                        <th class="px-6 py-4">Màu phôi</th>
                        <th class="px-6 py-4 text-center">Kích thước</th>
                        <th class="px-6 py-4 text-center">Số lượng</th>
                        <th class="px-6 py-4 text-right pr-8">Trạng thái</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100 text-slate-700">

                    @{
                        int stt = 1;
                    }

                    @foreach (var item in Model)
                    {
                        var qty = item.Quantity ?? 0;

                        <tr class="hover:bg-slate-50 transition-all duration-200 @(stt % 2 == 0 ? "bg-slate-50/30" : "bg-white")">

                            <td class="py-5 px-5 font-semibold text-slate-500">
                                @(stt++)
                            </td>

                            <td class="px-6 py-5 font-bold text-slate-800">

                                <div class="flex items-center gap-3">

                                    <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center">
                                        <span class="material-symbols-outlined text-[#031635] text-[20px]">
                                            apparel
                                        </span>
                                    </div>

                                    @item.ProductVariant?.Product?.ProductName
                                </div>
                            </td>

                            <td class="px-6 py-5 font-medium text-slate-600">
                                @item.ProductVariant?.Color
                            </td>

                            <td class="px-6 py-5 text-center font-bold">
                                @item.ProductVariant?.Size
                            </td>

                            <td class="px-6 py-5 text-center">
                                <span class="text-lg font-black text-slate-900">
                                    @qty
                                </span>
                            </td>

                            <td class="px-6 py-5 text-right pr-8">

                                @if (qty == 0)
                                {
                                    <span class="inline-flex items-center gap-1 px-4 py-1.5 rounded-full bg-red-100 text-red-600 text-xs font-bold">
                                        <span class="material-symbols-outlined text-[16px]">error</span>
                                        Hết hàng
                                    </span>
                                }
                                else if (qty <= 5)
                                {
                                    <span class="inline-flex items-center gap-1 px-4 py-1.5 rounded-full bg-amber-100 text-amber-700 text-xs font-bold animate-pulse">
                                        <span class="material-symbols-outlined text-[16px]">warning</span>
                                        Sắp hết
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-4 py-1.5 rounded-full bg-emerald-100 text-emerald-700 text-xs font-bold">
                                        <span class="material-symbols-outlined text-[16px]">check_circle</span>
                                        Tồn kho an toàn
                                    </span>
                                }

                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>