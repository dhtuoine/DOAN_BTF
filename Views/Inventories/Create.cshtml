@model DOAN_BTF.Models.Inventory
@{
    ViewData["Title"] = "Nhập kho phôi áo";
}


<div class="p-8">
    <div class="max-w-3xl mx-auto mb-6">
        <nav class="flex items-center gap-2 text-sm text-slate-400 mb-2">
            <a href="@Url.Action("Index")" class="hover:text-slate-800 transition">Kho hàng</a>
            <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            <span class="font-semibold text-slate-800">Lập phiếu nhập</span>
        </nav>
        <h1 class="text-4xl font-extrabold text-[#031635]">Lập phiếu nhập kho phôi</h1>
    </div>

    <div class="max-w-3xl mx-auto bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden">
        <div class="px-8 py-5 border-b border-slate-100 bg-slate-50 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-500 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">input</span>
            </div>
            <div>
                <h2 class="font-bold text-slate-800 text-base">Thông tin lô phôi nhập kho</h2>
                <p class="text-slate-400 text-xs mt-0.5">Cộng số lượng tồn kho áo phôi mới nhập</p>
            </div>
        </div>

        <form asp-action="Create" method="post" class="p-8 space-y-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-xs text-red-600 bg-red-50 p-4 rounded-xl border border-red-100"></div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Lựa chọn cấu hình phôi áo nhập</label>
                <select asp-for="ProductVariantId" asp-items="ViewBag.ProductVariantId" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm focus:ring-4 focus:ring-emerald-100 focus:outline-none" required>
                    <option value="">-- Click chọn loại phôi --</option>
                </select>
                <span asp-validation-for="ProductVariantId" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Số lượng kiện nhập kho</label>
                <input name="Quantity" type="number" min="1" placeholder="Nhập số lượng nhập..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-4 focus:ring-emerald-100 focus:outline-none" required />
            </div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Thông tin nguồn nhập / Ghi chú</label>
                <textarea name="Note" rows="3" placeholder="Nhập nguồn gốc hoặc thông tin lô hàng..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none resize-none"></textarea>
            </div>

            <div class="pt-5 border-t border-slate-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2 rounded-xl border border-slate-300 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition">Hủy bỏ</a>
                <button type="submit" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow transition flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px]">check_circle</span> Xác nhận nhập kho
                </button>
            </div>
        </form>
    </div>
</div>