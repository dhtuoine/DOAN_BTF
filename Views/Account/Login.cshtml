@model DOAN_BTF.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập | BTF Embroidery</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <style>
        :root {
            --primary: #031635;
            --primary-hover: #0f2d63;
            --primary-light: #3b82f6;
            --bg: #f8fafc;
        }

        * {
            box-sizing: border-box;
            font-family: Inter, sans-serif;
        }

        body {
            min-height: 100vh;
            background: radial-gradient(circle at top left, #dbeafe 0%, transparent 35%), radial-gradient(circle at bottom right, #e0e7ff 0%, transparent 35%), var(--bg);
            overflow-x: hidden;
            position: relative;
        }

        .bg-circle-1 {
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: 999px;
            background: rgba(3, 22, 53, 0.05);
            top: -120px;
            right: -120px;
        }

        .bg-circle-2 {
            position: absolute;
            width: 320px;
            height: 320px;
            border-radius: 999px;
            background: rgba(59, 130, 246, 0.06);
            bottom: -80px;
            left: -80px;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 36px;
            overflow: hidden;
            box-shadow: 0 30px 80px rgba(15, 23, 42, 0.08), 0 10px 30px rgba(15, 23, 42, 0.05);
        }

        .logo-container {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
        }

        .logo-box {
            width: 100px;
            height: 100px;
            border-radius: 28px;
            background: #ffffff;
            box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8px;
            overflow: hidden;
        }

            .logo-box img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

        .main-title {
            color: var(--primary);
            font-weight: 800;
            font-size: 34px;
        }

        .sub-title {
            color: #64748b;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: .18em;
        }

        .input-group-custom {
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            overflow: hidden;
            transition: all .3s ease;
            background: white;
        }

            .input-group-custom:focus-within {
                border-color: var(--primary-light);
                box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
            }

            .input-group-custom .input-group-text {
                border: none;
                background: white;
                color: #64748b;
                padding-left: 18px;
            }

            .input-group-custom .form-control {
                border: none;
                box-shadow: none;
                padding: 16px 12px;
            }

        .forgot-link {
            color: var(--primary-light);
            font-weight: 500;
            transition: color 0.2s ease;
        }

            .forgot-link:hover {
                color: var(--primary-hover);
            }

        .form-check-input:checked {
            background-color: var(--primary);
            border-color: var(--primary);
        }

        .login-btn {
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 20px;
            padding: 15px;
            font-weight: 700;
            transition: all .3s ease;
        }

            .login-btn:hover {
                background: var(--primary-hover);
                transform: translateY(-2px);
                color: white;
            }

        .custom-alert {
            background: #fff1f2;
            border: 1px solid #fecdd3;
            color: #e11d48;
            padding: 14px 18px;
            border-radius: 18px;
            font-size: 14px;
            font-weight: 500;
        }

            .custom-alert ul {
                list-style-type: none;
                margin: 0;
                padding: 0;
            }
    </style>
</head>

<body>

    <div class="bg-circle-1"></div>
    <div class="bg-circle-2"></div>

    <div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">

        <div class="w-100" style="max-width:480px; position: relative; z-index: 2;">

            <div class="login-card">

                <div class="p-4 p-md-5">

                    <div class="text-center mb-4">

                        <div class="logo-container mb-4">
                            <div class="logo-box">
                                <img src="~/image/btf.png"
                                     asp-append-version="true"
                                     alt="BTF Logo" />
                            </div>
                        </div>

                        <h1 class="main-title mb-2">BTF</h1>

                        <div class="sub-title">
                            EMBROIDERY MANAGEMENT SYSTEM
                        </div>

                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="custom-alert mb-4 d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined">warning</span>
                            <span>@TempData["Error"]</span>
                        </div>
                    }

                    <form asp-action="Login"
                          asp-controller="Account"
                          method="post">

                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid &&
                                                ViewData.ModelState.Values.Any(v => v.Errors.Any()))
                        {
                            <div asp-validation-summary="ModelOnly"
                                 class="custom-alert mb-4"></div>
                        }

                        <!-- USERNAME -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold text-secondary small mb-2">
                                Tên đăng nhập
                            </label>

                            <div class="input-group input-group-custom">

                                <span class="input-group-text">
                                    <span class="material-symbols-outlined">person</span>
                                </span>

                                <input asp-for="Username"
                                       class="form-control"
                                       placeholder="Nhập username..."
                                       autocomplete="username" />

                            </div>

                            <span asp-validation-for="Username"
                                  class="text-danger small mt-1 d-block"></span>

                        </div>

                        <!-- PASSWORD -->
                        <div class="mb-4">

                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <label class="form-label fw-semibold text-secondary small mb-0">
                                    Mật khẩu
                                </label>

                                <a href="#"
                                   class="small text-decoration-none forgot-link">
                                    Quên mật khẩu?
                                </a>

                            </div>

                            <div class="input-group input-group-custom">

                                <span class="input-group-text">
                                    <span class="material-symbols-outlined">lock</span>
                                </span>

                                <input asp-for="Password"
                                       id="Password"
                                       type="password"
                                       class="form-control"
                                       placeholder="Nhập mật khẩu..."
                                       autocomplete="current-password" />

                                <button class="btn bg-white border-0 px-3 d-flex align-items-center text-secondary"
                                        type="button"
                                        id="togglePassword">

                                    <span class="material-symbols-outlined"
                                          id="eyeIcon">
                                        visibility_off
                                    </span>

                                </button>

                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger small mt-1 d-block"></span>

                        </div>

                        <!-- REMEMBER -->
                        <div class="mb-4 form-check d-flex align-items-center gap-2">

                            <input asp-for="RememberMe"
                                   class="form-check-input m-0" />

                            <label asp-for="RememberMe"
                                   class="form-check-label small text-secondary fw-medium">
                                Ghi nhớ đăng nhập
                            </label>

                        </div>

                        <button type="submit"
                                class="login-btn w-100">
                            Đăng nhập
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <script>
        const togglePassword = document.getElementById("togglePassword");
        const password = document.getElementById("Password");
        const eyeIcon = document.getElementById("eyeIcon");

        togglePassword.addEventListener("click", function () {

            if (password.type === "password") {
                password.type = "text";
                eyeIcon.textContent = "visibility";
            }
            else {
                password.type = "password";
                eyeIcon.textContent = "visibility_off";
            }

        });
    </script>

</body>
</html>