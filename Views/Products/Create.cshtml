@model DOAN_BTF.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm";
}



<div class="p-8">

    <div class="max-w-3xl mx-auto">

        <!-- HEADER -->
        <div class="mb-10">

            <h1 class="text-5xl font-black text-[#031635]">
                Thêm sản phẩm
            </h1>

        </div>

        <!-- CARD -->
        <div class="bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden">

            <!-- TOP -->
            <div class="px-8 py-6 border-b border-slate-100 bg-slate-50">

                <div class="flex items-center gap-4">

                    <div class="w-16 h-16 rounded-3xl bg-[#031635]/10 flex items-center justify-center">

                        <span class="material-symbols-outlined text-[#031635] text-[32px]">
                            inventory_2
                        </span>

                    </div>

                    <div>

                        <h2 class="text-2xl font-bold text-slate-800">
                            Thông tin sản phẩm
                        </h2>

                        <p class="text-slate-500 mt-1">
                            Nhập tên sản phẩm để tạo mới
                        </p>

                    </div>

                </div>

            </div>

            <!-- FORM -->
            <form asp-action="Create">

                <div class="p-8">

                    <div asp-validation-summary="ModelOnly"
                         class="mb-6 rounded-2xl bg-red-50 border border-red-200 text-red-500 px-5 py-4">
                    </div>

                    <!-- PRODUCT NAME -->
                    <div>

                        <label asp-for="ProductName"
                               class="block text-sm font-semibold text-slate-700 mb-3">

                            Tên sản phẩm

                        </label>

                        <input asp-for="ProductName"
                               placeholder="Ví dụ: BodySuit"
                               class="w-full rounded-2xl border border-slate-200
                                      bg-white px-5 py-4 text-slate-700
                                      shadow-sm
                                      focus:outline-none
                                      focus:ring-4
                                      focus:ring-blue-100
                                      focus:border-[#031635]
                                      transition-all duration-300" />

                        <span asp-validation-for="ProductName"
                              class="text-red-500 text-sm mt-2 block">
                        </span>

                    </div>

                </div>

                <!-- FOOTER -->
                <div class="px-8 py-6 border-t border-slate-100 bg-slate-50 flex items-center justify-end gap-4">

                    <a asp-action="Index"
                       class="px-6 py-3 rounded-2xl border border-slate-300
                              text-slate-700 font-semibold
                              hover:bg-slate-100
                              transition-all duration-300">

                        Huỷ

                    </a>

                    <button type="submit"
                            class="px-7 py-3 rounded-2xl
                                   bg-[#031635]
                                   hover:bg-[#0f2d63]
                                   text-white font-semibold
                                   shadow-lg shadow-blue-900/10
                                   hover:-translate-y-0.5
                                   transition-all duration-300">

                        Lưu sản phẩm

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}