@model IEnumerable<DOAN_BTF.Models.Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="p-6 space-y-6">

    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-slate-900">Quản lý sản phẩm</h1>
            <p class="text-sm text-slate-500 mt-1">
                Quản lý sản phẩm gốc, màu sắc và kích thước phôi áo trong hệ thống.
            </p>
        </div>

        <a asp-action="Create"
           class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-[#031635] text-white text-sm font-bold shadow-lg shadow-blue-950/10 hover:bg-[#0f2d63] hover:-translate-y-0.5 transition-all">
            <span class="material-symbols-outlined text-[20px]">add_box</span>
            Thêm sản phẩm mới
        </a>
    </div>

    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-5">
        <form method="get">
            <div class="relative">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">
                    search
                </span>
                <input name="search"
                       value="@Context.Request.Query["search"]"
                       class="w-full pl-12 pr-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-sm focus:bg-white focus:border-[#031635] focus:ring-4 focus:ring-blue-100 outline-none transition"
                       placeholder="Tìm kiếm theo tên sản phẩm..." />
            </div>
        </form>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-1 xl:grid-cols-2 2xl:grid-cols-3 gap-6 items-start">
            @foreach (var item in Model)
            {
                var variantCount = item.ProductVariants?.Count ?? 0;
                var colorCount = item.ProductVariants?
                .Where(v => !string.IsNullOrWhiteSpace(v.Color))
                .Select(v => v.Color)
                .Distinct()
                .Count() ?? 0;

                var sizeCount = item.ProductVariants?
                .Where(v => !string.IsNullOrWhiteSpace(v.Size))
                .Select(v => v.Size)
                .Distinct()
                .Count() ?? 0;

                <div class="group bg-white rounded-[28px] border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">

                    <div class="p-5 border-b border-slate-100 bg-gradient-to-br from-white to-slate-50">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex items-start gap-4 min-w-0">
                                <div class="w-14 h-14 rounded-2xl bg-blue-50 text-[#031635] flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-[28px]">apparel</span>
                                </div>

                                <div class="min-w-0">
                                    <h2 class="text-lg font-black text-slate-900 truncate">
                                        @item.ProductName
                                    </h2>

                                    <div class="flex flex-wrap gap-2 mt-2">
                                        <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 text-[11px] font-bold">
                                            @variantCount biến thể
                                        </span>
                                        <span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-[11px] font-bold">
                                            @colorCount màu
                                        </span>
                                        <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-[11px] font-bold">
                                            @sizeCount size
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <button type="button"
                                    onclick="openDeleteModal(@item.Id, '@item.ProductName')"
                                    class="w-10 h-10 rounded-xl bg-red-50 text-red-500 hover:bg-red-500 hover:text-white flex items-center justify-center transition">
                                <span class="material-symbols-outlined text-[20px]">delete</span>
                            </button>
                        </div>
                    </div>

                    <div class="p-5">
                        @if (item.ProductVariants != null && item.ProductVariants.Any())
                        {
                            <div class="max-h-[330px] overflow-y-auto pr-1 custom-scroll">
                                <div class="space-y-2">
                                    @{
                                        int stt = 1;
                                    }

                                    @foreach (var v in item.ProductVariants)
                                    {
                                        <div class="flex items-center justify-between gap-3 rounded-2xl border border-slate-100 bg-slate-50/70 px-4 py-3 hover:bg-slate-100 transition">
                                            <div class="flex items-center gap-3 min-w-0">
                                                <div class="w-8 h-8 rounded-xl bg-white border border-slate-100 flex items-center justify-center text-xs font-black text-slate-500">
                                                    @(stt++)
                                                </div>

                                                <div class="min-w-0">
                                                    <div class="font-bold text-sm text-slate-800 truncate">
                                                        @(v.Color ?? "Chưa có màu")
                                                    </div>
                                                    <div class="text-xs text-slate-400 mt-0.5">
                                                        Kích thước: <span class="font-bold text-slate-600">@(v.Size ?? "Chưa có size")</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <button type="button"
                                                    onclick="openVariantDeleteModal(@v.Id, '@item.ProductName', '@v.Color', '@v.Size')"
                                                    class="px-3 py-1.5 rounded-xl bg-white text-red-500 border border-red-100 text-xs font-bold hover:bg-red-500 hover:text-white transition">
                                                Xóa
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="py-10 flex flex-col items-center justify-center text-center rounded-2xl bg-slate-50 border border-dashed border-slate-200">
                                <span class="material-symbols-outlined text-4xl text-slate-300 mb-2">inventory_2</span>
                                <p class="text-sm font-bold text-slate-500">Chưa có màu/size</p>
                                <p class="text-xs text-slate-400 mt-1">Hãy thêm biến thể đầu tiên cho sản phẩm này.</p>
                            </div>
                        }

                        <a asp-controller="ProductVariants"
                           asp-action="Create"
                           asp-route-productId="@item.Id"
                           class="mt-4 w-full inline-flex items-center justify-center gap-2 border border-dashed border-slate-300 rounded-2xl py-3 text-sm text-slate-500 font-bold hover:border-[#031635] hover:text-[#031635] hover:bg-slate-50 transition">
                            <span class="material-symbols-outlined text-[18px]">add</span>
                            Thêm màu / size
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm py-16 flex flex-col items-center justify-center text-center">
            <span class="material-symbols-outlined text-6xl text-slate-300 mb-3">inventory_2</span>
            <h2 class="text-xl font-black text-slate-800">Chưa có sản phẩm</h2>
            <p class="text-sm text-slate-500 mt-1">Bạn có thể tạo sản phẩm đầu tiên để bắt đầu quản lý.</p>
        </div>
    }
</div>

<div id="deleteModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50">
    <div class="bg-white rounded-[28px] p-8 w-full max-w-md shadow-2xl">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-red-50 text-red-500 flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-[34px]">warning</span>
        </div>

        <h2 class="text-2xl font-black text-center text-slate-900">Xác nhận xóa?</h2>

        <form id="deleteForm" method="post">
            @Html.AntiForgeryToken()

            <p class="text-sm text-slate-500 text-center mt-3 mb-6">
                Bạn có chắc muốn xóa sản phẩm
                <span id="lblProdName" class="font-black text-red-600"></span>?
            </p>

            <div class="flex gap-3">
                <button type="button"
                        onclick="closeDeleteModal()"
                        class="flex-1 py-3 rounded-2xl border border-slate-200 text-sm font-bold text-slate-600 hover:bg-slate-50 transition">
                    Hủy
                </button>

                <button type="submit"
                        class="flex-1 py-3 rounded-2xl bg-red-500 text-white text-sm font-bold hover:bg-red-600 shadow-md transition">
                    Xác nhận
                </button>
            </div>
        </form>
    </div>
</div>

<div id="variantDeleteModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50">
    <div class="bg-white rounded-[28px] p-8 w-full max-w-md shadow-2xl border border-slate-100">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-red-50 text-red-500 flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-[34px]">warning</span>
        </div>

        <h2 class="text-2xl font-black text-center text-slate-900">Loại bỏ biến thể?</h2>

        <p class="text-slate-500 text-center text-sm mt-3 leading-relaxed">
            Xác nhận gỡ bỏ cấu hình
            <span id="lblVariantInfo" class="font-black text-red-600"></span>
            khỏi danh mục.
        </p>

        <form id="variantDeleteForm" method="post" class="flex gap-3 mt-6">
            @Html.AntiForgeryToken()

            <button type="button"
                    onclick="closeVariantDeleteModal()"
                    class="flex-1 py-3 rounded-2xl border border-slate-200 text-sm font-bold text-slate-600 hover:bg-slate-50 transition">
                Hủy bỏ
            </button>

            <button type="submit"
                    class="flex-1 py-3 rounded-2xl bg-red-500 text-white text-sm font-bold hover:bg-red-600 shadow-md transition">
                Xóa ngay
            </button>
        </form>
    </div>
</div>

<style>
    .custom-scroll::-webkit-scrollbar {
        width: 6px;
    }

    .custom-scroll::-webkit-scrollbar-track {
        background: transparent;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 999px;
    }

        .custom-scroll::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
</style>

<script>
    function safeText(value) {
        return value ?? "";
    }

    function openDeleteModal(id, name) {
        const modal = document.getElementById("deleteModal");
        modal.classList.remove("hidden");
        modal.classList.add("flex");

        document.getElementById("lblProdName").innerText = safeText(name);
        document.getElementById("deleteForm").action = "/Products/Delete/" + id;
    }

    function closeDeleteModal() {
        const modal = document.getElementById("deleteModal");
        modal.classList.add("hidden");
        modal.classList.remove("flex");
    }

    function openVariantDeleteModal(id, prodName, color, size) {
        const modal = document.getElementById("variantDeleteModal");
        modal.classList.remove("hidden");
        modal.classList.add("flex");

        document.getElementById("lblVariantInfo").innerText =
            `${safeText(prodName)} (${safeText(color)} - ${safeText(size)})`;

        document.getElementById("variantDeleteForm").action = "/ProductVariants/Delete/" + id;
    }

    function closeVariantDeleteModal() {
        const modal = document.getElementById("variantDeleteModal");
        modal.classList.add("hidden");
        modal.classList.remove("flex");
    }
</script>