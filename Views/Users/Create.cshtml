@model DOAN_BTF.Models.User

@{
    ViewData["Title"] = "Thêm tài khoản";
}


<div class="p-8">

    <div class="max-w-3xl mx-auto">

        <!-- HEADER -->
        <div class="mb-10">

            <h1 class="text-5xl font-black text-[#031635]">
                Thêm tài khoản
            </h1>

            <p class="text-slate-500 mt-3 text-lg">
                Tạo tài khoản mới cho hệ thống quản lý
            </p>

        </div>

        <!-- CARD -->
        <div class="bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden">

            <!-- TOP -->
            <div class="px-8 py-6 border-b border-slate-100 bg-slate-50">

                <div class="flex items-center gap-5">

                    <!-- ICON -->
                    <div class="w-20 h-20 rounded-3xl bg-[#031635]/10 flex items-center justify-center">

                        <span class="material-symbols-outlined text-[#031635] text-[34px]">
                            person_add
                        </span>

                    </div>

                    <!-- INFO -->
                    <div>

                        <h2 class="text-2xl font-bold text-slate-800">
                            Thông tin tài khoản
                        </h2>

                        <p class="text-slate-500 mt-1">
                            Tài khoản sẽ được sử dụng để đăng nhập hệ thống
                        </p>

                    </div>

                </div>

            </div>

            <!-- FORM -->
            <form asp-action="Create"
                  method="post"
                  autocomplete="off">

                @Html.AntiForgeryToken()

                <div class="p-8 space-y-8">

                    <!-- VALIDATION -->
                    <div asp-validation-summary="ModelOnly"
                         class="rounded-2xl bg-red-50 border border-red-200 text-red-500 px-5 py-4">
                    </div>

                    <!-- USERNAME -->
                    <div>

                        <label asp-for="Username"
                               class="block text-sm font-semibold text-slate-700 mb-3">

                            Username

                        </label>

                        <div class="relative">

                            <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-slate-400">
                                person
                            </span>

                            <input asp-for="Username"
                                   autocomplete="new-username"
                                   placeholder="Nhập username..."
                                   class="w-full pl-14 pr-5 py-4 rounded-2xl
                                          border border-slate-200
                                          bg-white text-slate-700
                                          shadow-sm
                                          focus:outline-none
                                          focus:ring-4
                                          focus:ring-blue-100
                                          focus:border-[#031635]
                                          transition-all duration-300" />

                        </div>

                        <span asp-validation-for="Username"
                              class="text-red-500 text-sm mt-2 block">
                        </span>

                    </div>

                    <!-- PASSWORD -->
                    <div>

                        <label asp-for="Password"
                               class="block text-sm font-semibold text-slate-700 mb-3">

                            Password

                        </label>

                        <div class="relative">

                            <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-slate-400">
                                lock
                            </span>

                            <input asp-for="Password"
                                   id="passwordInput"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Nhập password..."
                                   class="w-full pl-14 pr-14 py-4 rounded-2xl
                                          border border-slate-200
                                          bg-white text-slate-700
                                          shadow-sm
                                          focus:outline-none
                                          focus:ring-4
                                          focus:ring-blue-100
                                          focus:border-[#031635]
                                          transition-all duration-300" />

                            <button type="button"
                                    id="togglePassword"
                                    class="absolute right-5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-[#031635] transition-all duration-300">

                                <span class="material-symbols-outlined">
                                    visibility
                                </span>

                            </button>

                        </div>

                        <span asp-validation-for="Password"
                              class="text-red-500 text-sm mt-2 block">
                        </span>

                    </div>

                    <!-- ROLE -->
                    <div>

                        <label asp-for="Role"
                               class="block text-sm font-semibold text-slate-700 mb-3">

                            Vai trò

                        </label>

                        <div class="relative">

                            <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-slate-400">
                                admin_panel_settings
                            </span>

                            <select asp-for="Role"
                                    class="w-full pl-14 pr-12 py-4 rounded-2xl
                                           border border-slate-200
                                           bg-white text-slate-700
                                           shadow-sm appearance-none
                                           focus:outline-none
                                           focus:ring-4
                                           focus:ring-blue-100
                                           focus:border-[#031635]
                                           transition-all duration-300">

                                <option value="">
                                    -- Chọn vai trò --
                                </option>

                                <option value="@((int)UserRole.Admin)">
                                    Admin
                                </option>

                                <option value="@((int)UserRole.Sales)">
                                    Sales
                                </option>

                                <option value="@((int)UserRole.Embroidery)">
                                    Embroidery
                                </option>

                            </select>

                            <span class="material-symbols-outlined absolute right-5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                                expand_more
                            </span>

                        </div>

                    </div>

                    <!-- ROOM -->
                    <div>

                        <label asp-for="RoomId"
                               class="block text-sm font-semibold text-slate-700 mb-3">

                            Phòng ban

                        </label>

                        <div class="relative">

                            <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-slate-400">
                                corporate_fare
                            </span>

                            <select asp-for="RoomId"
                                    asp-items="ViewBag.RoomId"
                                    class="w-full pl-14 pr-12 py-4 rounded-2xl
                                           border border-slate-200
                                           bg-white text-slate-700
                                           shadow-sm appearance-none
                                           focus:outline-none
                                           focus:ring-4
                                           focus:ring-blue-100
                                           focus:border-[#031635]
                                           transition-all duration-300">

                                <option value="">
                                    -- Chọn phòng ban --
                                </option>

                            </select>

                            <span class="material-symbols-outlined absolute right-5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                                expand_more
                            </span>

                        </div>

                    </div>

                    <!-- INFO BOX -->
                    <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-6">

                        <div class="flex items-start gap-4">

                            <!-- ICON -->
                            <div class="w-14 h-14 rounded-2xl bg-[#031635]/10 flex items-center justify-center flex-shrink-0">

                                <span class="material-symbols-outlined text-[#031635]">
                                    info
                                </span>

                            </div>

                            <!-- TEXT -->
                            <div>

                                <h4 class="font-bold text-slate-800 mb-2">
                                    Thông tin hệ thống
                                </h4>

                                <p class="text-sm text-slate-500 leading-relaxed">
                                    Tài khoản sau khi tạo sẽ được dùng để đăng nhập và phân quyền trong hệ thống quản lý.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- FOOTER -->
                <div class="px-8 py-6 border-t border-slate-100 bg-slate-50 flex flex-col sm:flex-row gap-4 justify-end">

                    <a asp-action="Index"
                       class="px-6 py-3 rounded-2xl border border-slate-300
                              text-slate-700 font-semibold text-center
                              hover:bg-slate-100
                              transition-all duration-300">

                        Quay lại

                    </a>

                    <button type="submit"
                            class="px-7 py-3 rounded-2xl
                                   bg-[#031635]
                                   hover:bg-[#0f2d63]
                                   text-white font-semibold
                                   shadow-lg shadow-blue-900/10
                                   hover:-translate-y-0.5
                                   transition-all duration-300
                                   flex items-center justify-center gap-2">

                        <span class="material-symbols-outlined text-[20px]">
                            add
                        </span>

                        Thêm tài khoản

                    </button>

                </div>

            </form>

        </div>

    </div>
    </div>



@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const togglePassword =
            document.getElementById('togglePassword');

        const passwordInput =
            document.getElementById('passwordInput');

        togglePassword.addEventListener('click', function () {

            const type =
                passwordInput.getAttribute('type') === 'password'
                ? 'text'
                : 'password';

            passwordInput.setAttribute('type', type);

            this.innerHTML =
                type === 'password'
                ? '<span class="material-symbols-outlined">visibility</span>'
                : '<span class="material-symbols-outlined">visibility_off</span>';
        });

    </script>

}