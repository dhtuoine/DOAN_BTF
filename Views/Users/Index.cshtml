@model IEnumerable<DOAN_BTF.Models.User>

@{
    ViewData["Title"] = "Quản lý tài khoản";
    int stt = 1;
}

<div class="p-8">
    <div class="max-w-[1500px] mx-auto space-y-8">

        <!-- HEADER -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
            <div>
                <h1 class="text-3xl font-black text-slate-900">Quản lý tài khoản</h1>
                <p class="text-sm text-slate-500 mt-1">
                    Quản lý người dùng, vai trò và phòng ban trong hệ thống.
                </p>
            </div>

            <a asp-action="Create"
               class="inline-flex items-center gap-2 px-6 py-4 rounded-2xl bg-[#031635] text-white font-bold shadow-lg shadow-blue-900/10 hover:bg-[#0f2d63] hover:-translate-y-0.5 transition-all duration-300 w-fit">
                <span class="material-symbols-outlined text-[20px]">add</span>
                Thêm tài khoản
            </a>
        </div>

        <!-- STATS -->
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">

            <div class="bg-white rounded-[28px] border border-slate-200 shadow-sm p-6 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm text-slate-500 font-medium">Tổng tài khoản</p>
                        <h3 class="text-4xl font-black text-[#031635] mt-3">@Model.Count()</h3>
                    </div>
                    <div class="w-14 h-14 rounded-2xl bg-[#031635]/10 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[#031635]">group</span>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-[28px] border border-slate-200 shadow-sm p-6 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm text-slate-500 font-medium">Admin</p>
                        <h3 class="text-4xl font-black text-red-500 mt-3">
                            @Model.Count(x => x.Role == (int)UserRole.Admin)
                        </h3>
                    </div>
                    <div class="w-14 h-14 rounded-2xl bg-red-100 flex items-center justify-center">
                        <span class="material-symbols-outlined text-red-500">admin_panel_settings</span>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-[28px] border border-slate-200 shadow-sm p-6 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm text-slate-500 font-medium">Sales</p>
                        <h3 class="text-4xl font-black text-emerald-600 mt-3">
                            @Model.Count(x => x.Role == (int)UserRole.Sales)
                        </h3>
                    </div>
                    <div class="w-14 h-14 rounded-2xl bg-emerald-100 flex items-center justify-center">
                        <span class="material-symbols-outlined text-emerald-600">shopping_bag</span>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-[28px] border border-slate-200 shadow-sm p-6 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm text-slate-500 font-medium">Embroidery</p>
                        <h3 class="text-4xl font-black text-purple-500 mt-3">
                            @Model.Count(x => x.Role == (int)UserRole.Embroidery)
                        </h3>
                    </div>
                    <div class="w-14 h-14 rounded-2xl bg-purple-100 flex items-center justify-center">
                        <span class="material-symbols-outlined text-purple-500">draw</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- TABLE -->
        <div class="bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden">

            <div class="px-8 py-6 border-b border-slate-100 bg-slate-50">
                <h2 class="text-2xl font-bold text-slate-800">Danh sách tài khoản</h2>
                <p class="text-slate-500 mt-2">
                    Theo dõi và quản lý tài khoản trong hệ thống
                </p>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-blue-50/50 border-b border-blue-100">
                        <tr class="text-left text-[11px] font-black text-primary uppercase tracking-wider">
                            <th class="px-6 py-4 font-semibold">STT</th>
                            <th class="px-6 py-4 font-semibold">Tài khoản</th>
                            <th class="px-6 py-4 font-semibold">Vai trò</th>
                            <th class="px-6 py-4 font-semibold">Phòng ban</th>
                            <th class="px-6 py-4 font-semibold text-center">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50 transition-all duration-300">
                                <td class="px-6 py-5 font-bold text-slate-700">
                                    @(stt++)
                                </td>

                                <td class="px-6 py-5">
                                    <div class="flex items-center gap-4">
                                        <div class="w-14 h-14 rounded-2xl bg-[#031635]/10 flex items-center justify-center">
                                            <span class="material-symbols-outlined text-[#031635]">person</span>
                                        </div>

                                        <div>
                                            <h4 class="font-bold text-slate-800">@item.Username</h4>
                                            <p class="text-xs text-slate-400 mt-1">ID: @item.Id</p>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-5">
                                    @if (item.Role == (int)UserRole.Admin)
                                    {
                                        <span class="px-3 py-1 rounded-lg text-xs font-bold bg-red-50 text-red-600 border border-red-100">Admin</span>
                                    }
                                    else if (item.Role == (int)UserRole.Sales)
                                    {
                                        <span class="px-3 py-1 rounded-lg text-xs font-bold bg-emerald-50 text-emerald-600 border border-emerald-100">Sales</span>
                                    }
                                    else if (item.Role == (int)UserRole.Embroidery)
                                    {
                                        <span class="px-3 py-1 rounded-lg text-xs font-bold bg-purple-50 text-purple-600 border border-purple-100">Embroidery</span>
                                    }
                                </td>

                                <td class="px-6 py-5 text-slate-700 font-medium">
                                    @(item.Room?.RoomName ?? "Chưa có")
                                </td>

                                <td class="px-6 py-5">
                                    <div class="flex items-center justify-center gap-3">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="w-11 h-11 rounded-2xl bg-[#031635]/10 text-[#031635] hover:bg-[#031635] hover:text-white flex items-center justify-center transition-all duration-300">
                                            <span class="material-symbols-outlined text-[20px]">edit</span>
                                        </a>

                                        <button type="button"
                                                onclick="openDeleteModal(@item.Id)"
                                                class="w-11 h-11 rounded-2xl bg-red-100 text-red-500 hover:bg-red-500 hover:text-white flex items-center justify-center transition-all duration-300">
                                            <span class="material-symbols-outlined text-[20px]">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<!-- DELETE MODAL -->
<div id="deleteModal"
     class="fixed inset-0 bg-black/40 backdrop-blur-sm hidden items-center justify-center z-50">

    <div class="bg-white rounded-[32px] w-full max-w-md p-8 shadow-2xl">
        <div class="w-20 h-20 rounded-3xl bg-red-100 flex items-center justify-center mx-auto">
            <span class="material-symbols-outlined text-red-500 text-[40px]">warning</span>
        </div>

        <h3 class="text-2xl font-black text-center text-slate-800 mt-6">
            Xác nhận xóa tài khoản
        </h3>

        <p class="text-slate-500 text-center mt-3 leading-relaxed">
            Bạn có chắc chắn muốn xóa tài khoản này?
        </p>

        <div class="flex items-center justify-center gap-4 mt-8">
            <button type="button"
                    onclick="closeDeleteModal()"
                    class="px-6 py-3 rounded-2xl border border-slate-300 text-slate-700 hover:bg-slate-100 transition-all duration-300 font-semibold">
                Huỷ
            </button>

            <form id="deleteForm" method="post">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="px-6 py-3 rounded-2xl bg-red-500 text-white hover:bg-red-600 transition-all duration-300 font-semibold">
                    Xóa ngay
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function openDeleteModal(id) {
        const modal = document.getElementById('deleteModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');

        document.getElementById('deleteForm').action = '/Users/Delete/' + id;
    }

    function closeDeleteModal() {
        const modal = document.getElementById('deleteModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
</script>