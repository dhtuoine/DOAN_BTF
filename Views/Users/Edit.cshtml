@model DOAN_BTF.Models.User

@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
}


<div class="p-8">

    <div class="max-w-6xl mx-auto">

        <!-- HEADER -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 mb-10">

            <div>

                <h1 class="text-5xl font-black text-[#031635]">
                    Chỉnh sửa tài khoản
                </h1>


            </div>

            <!-- STATUS -->
            <div class="inline-flex items-center gap-3 px-5 py-3 rounded-2xl bg-emerald-100 text-emerald-600 font-semibold w-fit">

                <span class="w-3 h-3 rounded-full bg-emerald-500"></span>

                Đang hoạt động

            </div>

        </div>

        <!-- CONTENT -->
        <div class="grid grid-cols-12 gap-7">

            <!-- LEFT -->
            <div class="col-span-12 xl:col-span-8">

                <div class="bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden">

                    <!-- TOP -->
                    <div class="px-8 py-8 border-b border-slate-100 bg-slate-50">

                        <div class="flex items-center gap-6">

                            <!-- AVATAR -->
                            <div class="w-24 h-24 rounded-[28px] bg-[#031635]/10 flex items-center justify-center">

                                <span class="material-symbols-outlined text-[#031635] text-[42px]">
                                    manage_accounts
                                </span>

                            </div>

                            <!-- INFO -->
                            <div>

                                <h2 class="text-3xl font-black text-slate-800">
                                    @Model.Username
                                </h2>

                                <p class="text-slate-500 mt-2">
                                    USER-@Model.Id
                                </p>

                            </div>

                        </div>

                    </div>

                    <!-- FORM -->
                    <form asp-action="Edit"
                          method="post">

                        <div class="p-8 space-y-8">

                            <input type="hidden"
                                   asp-for="Id" />

                            <!-- VALIDATION -->
                            <div asp-validation-summary="ModelOnly"
                                 class="rounded-2xl bg-red-50 border border-red-200 text-red-500 px-5 py-4">
                            </div>

                            <!-- USERNAME -->
                            <div>

                                <label asp-for="Username"
                                       class="block text-sm font-semibold text-slate-700 mb-3">

                                    Username

                                </label>

                                <div class="relative">

                                    <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-slate-400">
                                        person
                                    </span>

                                    <input asp-for="Username"
                                           placeholder="Nhập username..."
                                           class="w-full pl-14 pr-5 py-4 rounded-2xl
                                                  border border-slate-200
                                                  bg-white text-slate-700
                                                  shadow-sm
                                                  focus:outline-none
                                                  focus:ring-4
                                                  focus:ring-blue-100
                                                  focus:border-[#031635]
                                                  transition-all duration-300" />

                                </div>

                            </div>

                            <!-- PASSWORD -->
                            <div>

                                <label asp-for="Password"
                                       class="block text-sm font-semibold text-slate-700 mb-3">

                                    Password mới

                                </label>

                                <div class="relative">

                                    <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-slate-400">
                                        lock
                                    </span>

                                    <input asp-for="Password"
                                           id="passwordInput"
                                           type="password"
                                           placeholder="Để trống nếu không đổi mật khẩu"
                                           class="w-full pl-14 pr-14 py-4 rounded-2xl
                                                  border border-slate-200
                                                  bg-white text-slate-700
                                                  shadow-sm
                                                  focus:outline-none
                                                  focus:ring-4
                                                  focus:ring-blue-100
                                                  focus:border-[#031635]
                                                  transition-all duration-300" />

                                    <button type="button"
                                            id="togglePassword"
                                            class="absolute right-5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-[#031635] transition-all duration-300">

                                        <span class="material-symbols-outlined">
                                            visibility
                                        </span>

                                    </button>

                                </div>

                                <p class="text-sm text-slate-400 mt-2">
                                    Không nhập nếu muốn giữ nguyên mật khẩu cũ
                                </p>

                            </div>

                            <!-- ROLE -->
                            <div>

                                <label asp-for="Role"
                                       class="block text-sm font-semibold text-slate-700 mb-3">

                                    Vai trò

                                </label>

                                <div class="relative">

                                    <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-slate-400">
                                        admin_panel_settings
                                    </span>

                                    <select asp-for="Role"
                                            class="w-full pl-14 pr-12 py-4 rounded-2xl
                                                   border border-slate-200
                                                   bg-white text-slate-700
                                                   shadow-sm appearance-none
                                                   focus:outline-none
                                                   focus:ring-4
                                                   focus:ring-blue-100
                                                   focus:border-[#031635]
                                                   transition-all duration-300">

                                        <option value="@((int)UserRole.Admin)">
                                            Admin
                                        </option>

                                        <option value="@((int)UserRole.Sales)">
                                            Sales
                                        </option>

                                        <option value="@((int)UserRole.Embroidery)">
                                            Embroidery
                                        </option>

                                    </select>

                                    <span class="material-symbols-outlined absolute right-5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                                        expand_more
                                    </span>

                                </div>

                            </div>

                            <!-- ROOM -->
                            <div>

                                <label asp-for="RoomId"
                                       class="block text-sm font-semibold text-slate-700 mb-3">

                                    Phòng ban

                                </label>

                                <div class="relative">

                                    <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-slate-400">
                                        corporate_fare
                                    </span>

                                    <select asp-for="RoomId"
                                            asp-items="ViewBag.RoomId"
                                            class="w-full pl-14 pr-12 py-4 rounded-2xl
                                                   border border-slate-200
                                                   bg-white text-slate-700
                                                   shadow-sm appearance-none
                                                   focus:outline-none
                                                   focus:ring-4
                                                   focus:ring-blue-100
                                                   focus:border-[#031635]
                                                   transition-all duration-300">

                                        <option value="">
                                            -- Chọn phòng ban --
                                        </option>

                                    </select>

                                    <span class="material-symbols-outlined absolute right-5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                                        expand_more
                                    </span>

                                </div>

                            </div>

                            <!-- INFO BOX -->
                            <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-6">

                                <div class="flex items-start gap-4">

                                    <!-- ICON -->
                                    <div class="w-14 h-14 rounded-2xl bg-[#031635]/10 flex items-center justify-center flex-shrink-0">

                                        <span class="material-symbols-outlined text-[#031635]">
                                            info
                                        </span>

                                    </div>

                                    <!-- TEXT -->
                                    <div>

                                        <h4 class="font-bold text-slate-800 mb-2">
                                            Lưu ý cập nhật
                                        </h4>

                                        <p class="text-sm text-slate-500 leading-relaxed">
                                            Sau khi lưu thay đổi, thông tin tài khoản và quyền truy cập sẽ được cập nhật ngay trong hệ thống.
                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- FOOTER -->
                        <div class="px-8 py-6 border-t border-slate-100 bg-slate-50 flex flex-col sm:flex-row gap-4 justify-end">

                            <a asp-action="Index"
                               class="px-6 py-3 rounded-2xl border border-slate-300
                                      text-slate-700 font-semibold text-center
                                      hover:bg-slate-100
                                      transition-all duration-300">

                                Quay lại

                            </a>

                            <button type="submit"
                                    class="px-7 py-3 rounded-2xl
                                           bg-[#031635]
                                           hover:bg-[#0f2d63]
                                           text-white font-semibold
                                           shadow-lg shadow-blue-900/10
                                           hover:-translate-y-0.5
                                           transition-all duration-300
                                           flex items-center justify-center gap-2">

                                <span class="material-symbols-outlined text-[20px]">
                                    save
                                </span>

                                Lưu thay đổi

                            </button>

                        </div>

                    </form>

                </div>

            </div>

            <!-- RIGHT -->
            <div class="col-span-12 xl:col-span-4 space-y-6">

                <!-- QUICK INFO -->
                <div class="bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden">

                    <!-- HEADER -->
                    <div class="px-6 py-5 border-b border-slate-100 bg-slate-50">

                        <h3 class="text-xl font-bold text-slate-800">
                            Thông tin nhanh
                        </h3>

                    </div>

                    <!-- BODY -->
                    <div class="p-6 space-y-5">

                        <!-- ID -->
                        <div class="flex items-center justify-between p-5 rounded-3xl bg-slate-50 border border-slate-100">

                            <div>

                                <p class="text-sm text-slate-500">
                                    Mã tài khoản
                                </p>

                                <h4 class="font-bold text-slate-800 mt-1">
                                    USER-@Model.Id
                                </h4>

                            </div>

                            <span class="material-symbols-outlined text-[#031635]">
                                badge
                            </span>

                        </div>

                        <!-- ROLE -->
                        <div class="flex items-center justify-between p-5 rounded-3xl bg-[#031635]/5 border border-[#031635]/10">

                            <div>

                                <p class="text-sm text-slate-500">
                                    Vai trò hiện tại
                                </p>

                                <h4 class="font-bold text-[#031635] mt-1">

                                    @if (Model.Role == (int)UserRole.Admin)
                                    {
                                        <span>Admin</span>
                                    }
                                    else if (Model.Role == (int)UserRole.Sales)
                                    {
                                        <span>Sales</span>
                                    }
                                    else if (Model.Role == (int)UserRole.Embroidery)
                                    {
                                        <span>Embroidery</span>
                                    }

                                </h4>

                            </div>

                            <span class="material-symbols-outlined text-[#031635]">
                                security
                            </span>

                        </div>

                        <!-- ROOM -->
                        <div class="flex items-center justify-between p-5 rounded-3xl bg-slate-50 border border-slate-100">

                            <div>

                                <p class="text-sm text-slate-500">
                                    Phòng ban
                                </p>

                                <h4 class="font-bold text-slate-800 mt-1">
                                    @(Model.Room?.RoomName ?? "Chưa có")
                                </h4>

                            </div>

                            <span class="material-symbols-outlined text-[#031635]">
                                corporate_fare
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const togglePassword =
            document.getElementById('togglePassword');

        const passwordInput =
            document.getElementById('passwordInput');

        togglePassword.addEventListener('click', function () {

            const type =
                passwordInput.getAttribute('type') === 'password'
                ? 'text'
                : 'password';

            passwordInput.setAttribute('type', type);

            this.innerHTML =
                type === 'password'
                ? '<span class="material-symbols-outlined">visibility</span>'
                : '<span class="material-symbols-outlined">visibility_off</span>';
        });

    </script>

}