@model DOAN_BTF.Models.ProductVariant
@{
    ViewData["Title"] = "Chỉnh sửa biến thể";
}

<div class="p-8">
    <div class="max-w-3xl mx-auto mb-6">
        <nav class="flex items-center gap-2 text-sm text-slate-400 mb-2">
            <a href="/Products/Index" class="hover:text-slate-800 transition">Sản phẩm</a>
            <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            <span class="font-semibold text-slate-800">Hiệu chỉnh biến thể</span>
        </nav>
        <h1 class="text-4xl font-extrabold text-[#031635] tracking-tight">Sửa biến thể Màu / Size</h1>
    </div>

    <div class="max-w-3xl mx-auto bg-slate-50/60 border border-slate-100 rounded-3xl shadow-sm overflow-hidden">
        <form asp-action="Edit" asp-controller="ProductVariants" method="post" class="p-8 space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-4 rounded-xl border border-red-100"></div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Thuộc sản phẩm gốc</label>
                <select asp-for="ProductId" asp-items="ViewBag.ProductId" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm focus:outline-none" required></select>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Sửa Màu phôi</label>
                    <select asp-for="Color" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm focus:outline-none" required>
                        <option>Dusty Pink</option>
                        <option>Cream</option>
                        <option>Sage Green</option>
                        <option>Forest Green</option>
                        <option>White</option>
                        <option>Mauve Taupe</option>
                        <option>Salmon</option>
                        <option>Blue</option>
                        <option>Light Blue</option>
                        <option>Light Pink</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Sửa Kích thước (Size)</label>
                    <select asp-for="Size" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm focus:outline-none" required>
                        <option>0-3M</option>
                        <option>3-6M</option>
                        <option>6-12M</option>
                        <option>12-18M</option>
                        <option>18-24M</option>
                    </select>
                </div>
            </div>

            <div class="pt-5 border-t border-slate-100 flex items-center justify-end gap-3 bg-white -mx-8 -mb-8 p-6">
                <a href="/Products/Index" class="px-5 py-2 rounded-xl border border-slate-300 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition">Hủy thay đổi</a>
                <button type="submit" class="px-5 py-2 rounded-xl bg-[#031635] text-white text-xs font-bold hover:bg-blue-950 shadow transition">Lưu cập nhật</button>
            </div>
        </form>
    </div>
</div>