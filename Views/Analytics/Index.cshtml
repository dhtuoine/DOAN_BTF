@{
    ViewData["Title"] = "Thống kê và dự báo sản xuất";
}

<div class="p-6 space-y-6">

    <!-- HEADER -->
    <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-5">
        <div>
            <h1 class="text-3xl font-black text-[#031635]">
                Thống kê và dự báo sản xuất
            </h1>
            <p class="text-sm text-slate-500 mt-1">
                Phân tích đơn hàng, sản lượng thêu và dự báo nhu cầu phôi áo theo thời gian.
            </p>
        </div>

        <div class="text-xs font-bold text-slate-400">
            Cập nhật lúc: @DateTime.Now.ToString("HH:mm dd/MM/yyyy")
        </div>
    </div>

    <!-- FILTER -->
    <form method="get"
          action="@Url.Action("Index", "Analytics")"
          class="bg-white rounded-3xl border border-slate-100 shadow-sm p-5">

        <div class="grid grid-cols-1 md:grid-cols-5 gap-4 items-end">

            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase mb-2">
                    Phòng ban
                </label>
                <select name="roomId"
                        class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:outline-none focus:ring-4 focus:ring-blue-100">
                    <option value="">Tất cả phòng</option>
                    @foreach (var room in ViewBag.Rooms)
                    {
                        <option value="@room.Id">@room.RoomName</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase mb-2">
                    Shop
                </label>
                <select name="shopId"
                        class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:outline-none focus:ring-4 focus:ring-blue-100">
                    <option value="">Tất cả shop</option>
                    @foreach (var shop in ViewBag.Shops)
                    {
                        <option value="@shop.Id">@shop.ShopName</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase mb-2">
                    Từ ngày
                </label>
                <input type="date"
                       name="fromDate"
                       value="@ViewBag.FromDate"
                       class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:outline-none focus:ring-4 focus:ring-blue-100" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase mb-2">
                    Đến ngày
                </label>
                <input type="date"
                       name="toDate"
                       value="@ViewBag.ToDate"
                       class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:outline-none focus:ring-4 focus:ring-blue-100" />
            </div>

            <div class="flex gap-2">
                <button type="submit"
                        class="flex-1 px-5 py-3 rounded-2xl bg-[#031635] text-white text-sm font-bold hover:bg-[#0f2d63] shadow-md transition flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">filter_alt</span>
                    Lọc
                </button>

                <a href="@Url.Action("Index", "Analytics")"
                   class="px-5 py-3 rounded-2xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition">
                    Xóa
                </a>
            </div>

        </div>
    </form>

    <!-- STATS -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-slate-400">
                        Đơn hàng trong chu kỳ
                    </p>
                    <h2 class="text-4xl font-black text-[#031635] mt-3">
                        @ViewBag.TotalOrders
                        <span class="text-xs font-medium text-slate-400">đơn</span>
                    </h2>
                    <p class="text-xs text-emerald-600 font-bold mt-2">
                        +12% so với chu kỳ trước
                    </p>
                </div>

                <div class="w-14 h-14 rounded-2xl bg-blue-50 text-[#031635] flex items-center justify-center">
                    <span class="material-symbols-outlined text-[28px]">receipt_long</span>
                </div>
            </div>
        </div>

        <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-slate-400">
                        Sản lượng thêu xong
                    </p>
                    <h2 class="text-4xl font-black text-emerald-600 mt-3">
                        @ViewBag.TotalProductsEmbroidered
                        <span class="text-xs font-medium text-slate-400">cái</span>
                    </h2>
                    <p class="text-xs text-emerald-600 font-bold mt-2">
                        Năng suất ổn định
                    </p>
                </div>

                <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[28px]">apparel</span>
                </div>
            </div>
        </div>

        <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-slate-400">
                        Tồn kho phôi tổng lực
                    </p>
                    <h2 class="text-4xl font-black text-slate-800 mt-3">
                        @ViewBag.TotalCurrentStock
                        <span class="text-xs font-medium text-slate-400">cái</span>
                    </h2>
                    <p class="text-xs text-blue-600 font-bold mt-2">
                        Đủ đáp ứng sản xuất
                    </p>
                </div>

                <div class="w-14 h-14 rounded-2xl bg-slate-100 text-slate-700 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[28px]">warehouse</span>
                </div>
            </div>
        </div>

    </div>

    <!-- CHARTS -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-6 min-h-[360px]">
            <div class="flex items-center justify-between mb-5">
                <div>
                    <h3 class="font-black text-slate-800">
                        Tỷ trọng đơn hàng theo phòng ban
                    </h3>
                    <p class="text-xs text-slate-400 mt-1">
                        Phân bổ số lượng đơn giữa các bộ phận kinh doanh
                    </p>
                </div>
            </div>

            <div class="relative w-full h-[280px]">
                <canvas id="chartRooms"></canvas>
            </div>
        </div>

        <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-6 min-h-[360px]">
            <div class="flex items-center justify-between mb-5">
                <div>
                    <h3 class="font-black text-slate-800">
                        Sản lượng chốt đơn theo shop
                    </h3>
                    <p class="text-xs text-slate-400 mt-1">
                        Theo dõi shop có số lượng đơn nổi bật
                    </p>
                </div>
            </div>

            <div class="relative w-full h-[280px]">
                <canvas id="chartShops"></canvas>
            </div>
        </div>

        <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-100 shadow-sm p-6 min-h-[360px]">
            <div class="flex items-center justify-between mb-5">
                <div>
                    <h3 class="font-black text-slate-800">
                        Top mẫu mã / họa tiết thêu phổ biến
                    </h3>
                    <p class="text-xs text-slate-400 mt-1">
                        Mẫu phôi có sản lượng tiêu thụ cao trong chu kỳ lọc
                    </p>
                </div>
            </div>

            <div class="relative w-full h-[280px]">
                <canvas id="chartBestSellers"></canvas>
            </div>
            <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-100 shadow-sm p-6 min-h-[360px]">
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <h3 class="font-black text-slate-800">
                            Trung bình trượt 7 ngày
                        </h3>
                        <p class="text-xs text-slate-400 mt-1">
                            Theo dõi xu hướng sản lượng thêu trung bình theo từng ngày
                        </p>
                    </div>

                    <div class="px-4 py-2 rounded-2xl bg-blue-50 text-blue-700 text-xs font-bold">
                        TB hiện tại: @ViewBag.LatestMovingAverage cái/ngày
                    </div>
                </div>

                <div class="relative w-full h-[280px]">
                    <canvas id="chartMovingAverage"></canvas>
                </div>
            </div>
        </div>

    </div>

    <!-- FORECAST -->
    <div class="rounded-3xl border border-dashed @(ViewBag.ForecastStatus == "Danger" ? "border-red-300 bg-red-50 text-red-900" : "border-blue-200 bg-blue-50 text-blue-900") p-6 shadow-sm">
        <div class="flex items-start gap-4">

            <div class="w-14 h-14 rounded-2xl @(ViewBag.ForecastStatus == "Danger" ? "bg-red-500 text-white" : "bg-[#031635] text-white") flex items-center justify-center flex-shrink-0 shadow-md">
                <span class="material-symbols-outlined text-[28px]">online_prediction</span>
            </div>

            <div class="space-y-1.5 flex-1">
                <h4 class="font-black text-lg tracking-tight">
                    BTF Smart Forecast
                </h4>

                <p class="text-sm leading-relaxed font-medium">
                    @ViewBag.ForecastMessage
                </p>
            </div>

        </div>
    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
        const roomLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((IEnumerable<dynamic>)ViewBag.RoomAnalytics).Select(x => x.Name)));
    const roomData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((IEnumerable<dynamic>)ViewBag.RoomAnalytics).Select(x => x.Count)));

    const shopLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((IEnumerable<dynamic>)ViewBag.ShopAnalytics).Select(x => x.Name)));
    const shopData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((IEnumerable<dynamic>)ViewBag.ShopAnalytics).Select(x => x.Count)));

    const topLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TopProductLabels));
    const topData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TopProductData));


    const chartColors = ['#031635', '#2563eb', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899'];

    new Chart(document.getElementById('chartRooms'), {
        type: 'doughnut',
        data: {
            labels: roomLabels.length ? roomLabels : ['Chưa có dữ liệu'],
            datasets: [{
                data: roomData.length ? roomData : [1],
                backgroundColor: chartColors,
                borderWidth: 4,
                borderColor: '#ffffff',
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '62%',
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        usePointStyle: true,
                        boxWidth: 8,
                        font: { size: 12, weight: '600' }
                    }
                }
            }
        }
    });

    new Chart(document.getElementById('chartShops'), {
        type: 'bar',
        data: {
            labels: shopLabels.length ? shopLabels : ['Chưa có shop'],
            datasets: [{
                label: 'Số đơn',
                data: shopData.length ? shopData : [0],
                backgroundColor: '#031635',
                borderRadius: 12,
                barThickness: 34
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { font: { size: 11, weight: '600' } }
                },
                y: {
                    beginAtZero: true,
                    grid: { color: '#f1f5f9' }
                }
            },
            plugins: {
                legend: { display: false }
            }
        }
    });

    new Chart(document.getElementById('chartBestSellers'), {
        type: 'bar',
        data: {
            labels: topLabels.length ? topLabels : ['Chưa có dữ liệu'],
            datasets: [{
                label: 'Sản lượng',
                data: topData.length ? topData : [0],
                backgroundColor: '#2563eb',
                borderRadius: 12,
                barThickness: 28
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: {
                    beginAtZero: true,
                    grid: { color: '#f1f5f9' }
                },
                y: {
                    grid: { display: false },
                    ticks: { font: { size: 11, weight: '600' } }
                }
            },
            plugins: {
                legend: { display: false }
            }
        }
    });

        new Chart(document.getElementById('chartMovingAverage'), {
        type: 'line',
        data: {
            labels: movingAverageLabels.length ? movingAverageLabels : ['Chưa có dữ liệu'],
            datasets: [{
                label: 'Trung bình trượt 7 ngày',
                data: movingAverageData.length ? movingAverageData : [0],
                borderColor: '#10b981',
                backgroundColor: 'rgba(16, 185, 129, 0.12)',
                borderWidth: 3,
                tension: 0.35,
                fill: true,
                pointRadius: 4,
                pointHoverRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { font: { size: 11, weight: '600' } }
                },
                y: {
                    beginAtZero: true,
                    grid: { color: '#f1f5f9' },
                    ticks: {
                        callback: function(value) {
                            return value + ' cái';
                        }
                    }
                }
            },
            plugins: {
                legend: {
                    display: true,
                    labels: {
                        usePointStyle: true,

                        font: { size: 12, weight: '600' }
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return 'Trung bình: ' + context.raw + ' cái/ngày';
                        }
                    }
                }
            }
        }
    });
</script>