@model DOAN_BTF.Models.Shop
@{
    ViewData["Title"] = "Thêm Shop mới";
}
<div class="p-8">
    <div class="max-w-3xl mx-auto mb-6">
        
        <h1 class="text-4xl font-black text-slate-900">Thêm cửa hàng mới</h1>
    </div>

    <div class="max-w-3xl mx-auto bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden">
        <div class="px-8 py-5 border-b border-slate-100 bg-slate-50/80 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center"><span class="material-symbols-outlined">storefront</span></div>
            <div>
                <h2 class="font-bold text-slate-800 text-lg">Thông số cửa hàng</h2>
               
            </div>
        </div>

        <form asp-action="Create" method="post" class="p-8 space-y-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-4 rounded-xl border border-red-100"></div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Tên Shop bán hàng</label>
                <input asp-for="ShopName" placeholder=" " class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-4 focus:ring-blue-100 focus:outline-none text-sm" required />
                <span asp-validation-for="ShopName" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Phòng ban quản trị phụ trách</label>
                <select asp-for="RoomId" asp-items="ViewBag.RoomId" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white focus:ring-4 focus:ring-blue-100 focus:outline-none text-sm" required>
                    <option value="">--  phòng ban phụ trách --</option>
                </select>
                <span asp-validation-for="RoomId" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                <a href="/Rooms/Index?roomId=@ViewBag.SelectedRoomId" class="px-5 py-2 rounded-xl border border-slate-300 text-sm font-medium text-slate-600 hover:bg-slate-50 transition">Hủy bỏ</a>
                <button type="submit" class="px-5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold shadow transition">   Thêm shop</button>
            </div>
        </form>
    </div>
</div>