@model DOAN_BTF.Models.Shop
@{
    ViewData["Title"] = "Chỉnh sửa cửa hàng";
}


<div class="p-8">
    <div class="max-w-3xl mx-auto mb-6">
        <nav class="flex items-center gap-2 text-sm text-slate-500 mb-2">
            <a href="/Rooms/Index?roomId=@Model.RoomId" class="hover:text-slate-800 transition">Cơ cấu</a>
            <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            <span class="font-semibold text-slate-800">Hiệu chỉnh shop</span>
        </nav>
        <h1 class="text-4xl font-black text-slate-900">Sửa cấu hình Shop</h1>
    </div>

    <div class="max-w-3xl mx-auto bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden">
        <form asp-action="Edit" method="post" class="p-8 space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-4 rounded-xl border border-red-100"></div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Tên gọi Shop</label>
                <input asp-for="ShopName" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-4 focus:ring-blue-100 focus:outline-none text-sm" required />
                <span asp-validation-for="ShopName" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Chuyển quyền sang Phòng ban khác</label>
                <select asp-for="RoomId" asp-items="ViewBag.RoomId" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white focus:ring-4 focus:ring-blue-100 focus:outline-none text-sm" required></select>
                <span asp-validation-for="RoomId" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                <a href="/Rooms/Index?roomId=@Model.RoomId" class="px-5 py-2 rounded-xl border border-slate-300 text-sm font-medium text-slate-600 hover:bg-slate-50 transition">Hủy thay đổi</a>
                <button type="submit" class="px-5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold shadow transition">Lưu cập nhật</button>
            </div>
        </form>
    </div>
</div>