@model DOAN_BTF.Models.Room

@{
    ViewData["Title"] = "Xóa phòng ban";
}

<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet" />

<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet" />

<style>
    body {
        font-family: 'Inter', sans-serif;
    }
</style>

<main class="min-h-screen bg-[#f8f9ff] p-8">

    <!-- HEADER -->
    <div class="max-w-4xl mx-auto mb-8">

        <!-- Breadcrumb -->
        <nav class="flex items-center gap-1 text-sm text-gray-500 mb-3">

            <a asp-action="Index"
               class="hover:text-blue-600 transition-colors">

                Phòng ban

            </a>

            <span class="material-symbols-outlined text-[16px]">
                chevron_right
            </span>

            <span class="text-red-500 font-medium">
                Xóa phòng ban
            </span>

        </nav>

        <!-- Title -->
        <h1 class="text-3xl font-bold text-gray-800">
            Xác nhận xóa phòng ban
        </h1>

        <p class="text-gray-500 mt-2">
            Kiểm tra thông tin trước khi thực hiện thao tác xóa.
        </p>

    </div>

    <!-- CONTENT -->
    <div class="max-w-4xl mx-auto grid grid-cols-12 gap-6">

        <!-- LEFT -->
        <div class="col-span-12 lg:col-span-8">

            <!-- WARNING CARD -->
            <div class="bg-white rounded-3xl border border-red-100 shadow-sm overflow-hidden">

                <!-- HEADER -->
                <div class="p-6 border-b border-red-100 bg-red-50 flex items-center gap-4">

                    <div class="w-14 h-14 rounded-2xl bg-red-100 flex items-center justify-center">

                        <span class="material-symbols-outlined text-red-500 text-3xl">
                            warning
                        </span>

                    </div>

                    <div>

                        <h3 class="text-xl font-semibold text-red-600">
                            Cảnh báo xóa dữ liệu
                        </h3>

                        <p class="text-sm text-red-400 mt-1">
                            Hành động này không thể hoàn tác.
                        </p>

                    </div>

                </div>

                <!-- BODY -->
                <div class="p-6 space-y-6">

                    <!-- ROOM NAME -->
                    <div>

                        <p class="text-sm text-gray-500 mb-2">
                            Tên phòng ban
                        </p>

                        <div class="px-5 py-4 rounded-2xl bg-gray-50 border border-gray-100 text-gray-800 font-semibold">

                            @Model.RoomName

                        </div>

                    </div>

                    <!-- DESCRIPTION -->
                    <div>

                        <p class="text-sm text-gray-500 mb-2">
                            Ảnh hưởng khi xóa
                        </p>

                        <div class="p-5 rounded-2xl bg-red-50 border border-red-100 text-red-500 leading-relaxed">

                            Tất cả dữ liệu liên quan đến phòng ban này có thể bị ảnh hưởng, bao gồm:
                            shop trực thuộc, phân công nhân sự và dữ liệu quản lý liên quan.

                        </div>

                    </div>

                    <!-- CONFIRM -->
                    <div class="flex items-start gap-3 p-4 rounded-2xl bg-orange-50 border border-orange-100">

                        <span class="material-symbols-outlined text-orange-500 mt-0.5">
                            info
                        </span>

                        <div>

                            <h4 class="font-semibold text-orange-600">
                                Lưu ý quan trọng
                            </h4>

                            <p class="text-sm text-orange-500 mt-1 leading-relaxed">
                                Hãy chắc chắn rằng phòng ban này không còn được sử dụng trước khi xóa khỏi hệ thống.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- RIGHT -->
        <div class="col-span-12 lg:col-span-4">

            <!-- INFO CARD -->
            <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">

                <!-- HEADER -->
                <div class="p-6 border-b border-gray-100">

                    <h3 class="text-lg font-semibold text-gray-800">
                        Thông tin nhanh
                    </h3>

                </div>

                <!-- BODY -->
                <div class="p-6 space-y-5">

                    <!-- ITEM -->
                    <div class="flex items-center justify-between p-4 rounded-2xl bg-blue-50">

                        <div>

                            <p class="text-sm text-gray-500">
                                Mã phòng
                            </p>

                            <h4 class="font-semibold text-gray-800 mt-1">
                                ROOM-@Model.Id
                            </h4>

                        </div>

                        <span class="material-symbols-outlined text-blue-600">
                            badge
                        </span>

                    </div>

                    <!-- ITEM -->
                    <div class="flex items-center justify-between p-4 rounded-2xl bg-red-50">

                        <div>

                            <p class="text-sm text-gray-500">
                                Trạng thái
                            </p>

                            <h4 class="font-semibold text-red-500 mt-1">
                                Sắp xóa
                            </h4>

                        </div>

                        <span class="material-symbols-outlined text-red-500">
                            delete
                        </span>

                    </div>

                </div>

            </div>

            <!-- ACTION CARD -->
            <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden mt-6">

                <div class="p-6">

                    <h3 class="text-lg font-semibold text-gray-800 mb-4">
                        Thao tác
                    </h3>

                    <form asp-action="Delete">

                        <input type="hidden"
                               asp-for="Id" />

                        <div class="space-y-3">

                            <button type="submit"
                                    class="w-full flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-red-500 text-white hover:bg-red-600 transition shadow-sm">

                                <span class="material-symbols-outlined text-[18px]">
                                    delete
                                </span>

                                Xóa phòng ban

                            </button>

                            <a asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="w-full flex items-center justify-center gap-2 px-5 py-3 rounded-2xl border border-gray-200 text-gray-700 hover:bg-gray-50 transition">

                                <span class="material-symbols-outlined text-[18px]">
                                    visibility
                                </span>

                                Xem chi tiết

                            </a>

                            <a asp-action="Index"
                               class="w-full flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-gray-100 text-gray-700 hover:bg-gray-200 transition">

                                <span class="material-symbols-outlined text-[18px]">
                                    arrow_back
                                </span>

                                Quay lại

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</main>