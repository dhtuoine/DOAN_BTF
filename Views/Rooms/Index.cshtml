@model DOAN_BTF.Models.RoomShopViewModel
@{
    ViewData["Title"] = "Quản lý Phòng ban";
}



<div class="p-8">
    <div class="max-w-[1500px] mx-auto">

  

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5 mb-8">
            <div class="bg-white rounded-[28px] border border-slate-200 shadow-sm p-6">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm text-slate-500 font-medium">Tổng phòng ban</p>
                        <h3 class="text-4xl font-black text-[#031635] mt-3">@Model.Rooms.Count</h3>
                    </div>
                    <div class="w-14 h-14 rounded-2xl bg-[#031635]/10 flex items-center justify-center text-[#031635]"><span class="material-symbols-outlined">corporate_fare</span></div>
                </div>
            </div>
            <div class="bg-white rounded-[28px] border border-slate-200 shadow-sm p-6">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm text-slate-500 font-medium">Cửa hàng đang kết nối</p>
                        <h3 class="text-4xl font-black text-slate-800 mt-3">@Model.Shops.Count</h3>
                    </div>
                    <div class="w-14 h-14 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-700"><span class="material-symbols-outlined">storefront</span></div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-12 gap-7 items-start">

            <section class="col-span-12 xl:col-span-4">
                <div class="flex items-center justify-between mb-5">
                    <h3 class="text-2xl font-bold text-slate-800">Phòng kinh doanh</h3>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Rooms" asp-action="Create" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#031635] text-white text-sm font-semibold hover:bg-blue-900 transition-all shadow-sm">Thêm phòng</a>
                    }
                    
                </div>

                <div class="space-y-4">
                    @foreach (var room in Model.Rooms)
                    {
                        <div class="@(Model.SelectedRoomId == room.Id ? "bg-blue-50/60 border-2 border-blue-400/40" : "bg-white border border-slate-200") rounded-[24px] p-5 shadow-sm hover:shadow-md transition-all duration-300 group relative">
                            <div class="flex items-center justify-between">
                                <a asp-action="Index" asp-route-roomId="@room.Id" class="flex items-center gap-4 flex-1">
                                    <div class="w-12 h-12 rounded-xl bg-[#031635]/5 flex items-center justify-center text-[#031635]"><span class="material-symbols-outlined">corporate_fare</span></div>
                                    <div>
                                        <h4 class="font-bold text-slate-800 text-base">@room.RoomName</h4>
                                        <p class="text-slate-400 text-xs mt-0.5">@room.Shops.Count shop trực thuộc</p>
                                    </div>
                                </a>
                                <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                    <a asp-action="Edit" asp-route-id="@room.Id" class="w-8 h-8 rounded-lg hover:bg-slate-100 text-slate-600 flex items-center justify-center"><span class="material-symbols-outlined text-[18px]">edit</span></a>
                                    <button type="button" onclick="openDeleteModal(@room.Id, '@room.RoomName')" class="w-8 h-8 rounded-lg hover:bg-red-50 text-red-500 flex items-center justify-center"><span class="material-symbols-outlined text-[18px]">delete</span></button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <section class="col-span-12 xl:col-span-8">
                <div class="bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden">
                    <div class="px-8 py-6 border-b border-slate-100 bg-slate-50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                        <div>
                            <h3 class="text-2xl font-bold text-slate-800">Danh sách Shop bộ phận</h3>
                            <p class="text-sm text-slate-500 mt-1">Đang xem cấu trúc: <span class="text-blue-600 font-bold">@(Model.Rooms.FirstOrDefault(r => r.Id == Model.SelectedRoomId)?.RoomName ?? "Tất cả phòng ban")</span></p>
                        </div>
                        @if (User.IsInRole("Sales"))
{
                        <a asp-controller="Shops" asp-action="Create" asp-route-roomId="@Model.SelectedRoomId" class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 text-white text-sm font-semibold hover:bg-slate-800 transition-all shadow-sm">
                            <span class="material-symbols-outlined text-[18px]">add</span>  Shop mới
                        </a>
}
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="bg-slate-100 border-b border-slate-200 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
                                <tr>
                                    <th class="px-6 py-4 pl-8">Thông tin tên Shop</th>
                                    <th class="px-6 py-4">Phòng ban quản lý</th>
                                    <th class="px-6 py-4 text-right pr-8">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-sm">
                                @if (Model.Shops != null && Model.Shops.Any())
                                {
                                    foreach (var shop in Model.Shops)
                                    {
                                        <tr class="hover:bg-slate-50/60 transition-colors">
                                            <td class="px-6 py-4 pl-8 font-bold text-slate-800 flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-600"><span class="material-symbols-outlined text-[20px]">storefront</span></div>
                                                <div>
                                                    <p class="text-slate-800">@shop.ShopName</p>
                                                    
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 text-slate-600 font-medium">@((shop.Room?.RoomName) ?? "Chưa phân phòng")</td>
                                            <td class="px-6 py-4 text-right pr-8">
                                                <div class="flex items-center justify-end gap-1">
                                                    <a asp-controller="Shops" asp-action="Edit" asp-route-id="@shop.Id" class="w-9 h-9 rounded-full hover:bg-slate-100 text-slate-600 flex items-center justify-center" title="Sửa tên shop"><span class="material-symbols-outlined text-[18px]">edit</span></a>
                                                    <button type="button" onclick="openShopDeleteModal(@shop.Id, '@shop.ShopName')" class="w-9 h-9 rounded-full hover:bg-red-50 text-red-500 flex items-center justify-center" title="Xóa shop"><span class="material-symbols-outlined text-[18px]">delete</span></button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="3" class="text-center py-12 text-slate-400 italic">Không có dữ liệu shop trực thuộc phòng ban này.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<div id="deleteModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50">
    <div class="bg-white rounded-[32px] w-full max-w-md p-8 shadow-2xl animate-fade-in">
        <div class="w-16 h-16 rounded-2xl bg-red-50 text-red-500 flex items-center justify-center mx-auto"><span class="material-symbols-outlined text-[36px]">warning</span></div>
        <h3 class="text-2xl font-bold text-center text-slate-800 mt-5">Xóa bỏ phòng ban?</h3>
        <p class="text-slate-500 text-center text-sm mt-2 leading-relaxed">Bạn chắc chắn muốn loại bỏ phòng ban <span id="roomName" class="font-bold text-red-600"></span> khỏi hệ thống? Thao tác này không thể hoàn tác.</p>
        <div class="flex items-center justify-center gap-3 mt-6 w-full">
            <button onclick="closeDeleteModal()" class="flex-1 py-2.5 rounded-xl border border-slate-300 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-all">Hủy</button>
            <form id="deleteForm" method="post" class="flex-1">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full py-2.5 rounded-xl bg-red-500 text-white text-sm font-semibold hover:bg-red-600 shadow-md transition-all">Xác nhận xóa</button>
            </form>
        </div>
    </div>
</div>

<div id="deleteShopModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-50">
    <div class="bg-white rounded-[32px] w-full max-w-md p-8 shadow-2xl">
        <div class="w-16 h-16 rounded-2xl bg-red-50 text-red-500 flex items-center justify-center mx-auto"><span class="material-symbols-outlined text-[36px]">warning</span></div>
        <h3 class="text-2xl font-bold text-center text-slate-800 mt-5">Ngắt kết nối Shop?</h3>
        <p class="text-slate-500 text-center text-sm mt-2 leading-relaxed">Xác nhận xóa shop bán hàng <span id="shopName" class="font-bold text-red-600"></span>? Dữ liệu đơn hàng cũ liên quan sẽ bị ảnh hưởng.</p>
        <div class="flex items-center justify-center gap-3 mt-6 w-full">
            <button onclick="closeShopDeleteModal()" class="flex-1 py-2.5 rounded-xl border border-slate-300 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-all">Hủy</button>
            <form id="deleteShopForm" method="post" class="flex-1">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full py-2.5 rounded-xl bg-red-500 text-white text-sm font-semibold hover:bg-red-600 shadow-md transition-all">Xóa ngay</button>
            </form>
        </div>
    </div>
</div>

<script>
    function openDeleteModal(id, name) {
        document.getElementById('deleteModal').classList.replace('hidden', 'flex');
        document.getElementById('roomName').innerText = name;
        document.getElementById('deleteForm').action = '/Rooms/Delete/' + id;
    }
    function closeDeleteModal() { document.getElementById('deleteModal').classList.replace('flex', 'hidden'); }

    function openShopDeleteModal(id, name) {
        document.getElementById('deleteShopModal').classList.replace('hidden', 'flex');
        document.getElementById('shopName').innerText = name;
        document.getElementById('deleteShopForm').action = '/Shops/Delete/' + id;
    }
    function closeShopDeleteModal() { document.getElementById('deleteShopModal').classList.replace('flex', 'hidden'); }
</script>