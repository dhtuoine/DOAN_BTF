@model DOAN_BTF.Models.Room

@{
    ViewData["Title"] = "Chỉnh sửa phòng ban";
}

<div class="p-8">

    <!-- HEADER -->
    <div class="max-w-6xl mx-auto mb-10">

        <!-- BREADCRUMB -->
        <nav class="flex items-center gap-2 text-sm text-slate-500 mb-4">

            <a asp-action="Index"
               class="hover:text-[#031635] transition-all duration-300">

                Phòng ban

            </a>

            <span class="material-symbols-outlined text-[18px]">
                chevron_right
            </span>

            <span class="font-semibold text-[#031635]">
                Chỉnh sửa phòng ban
            </span>

        </nav>

        <!-- TITLE -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">

            <div>

                <h1 class="text-5xl font-black text-[#031635]">
                    Chỉnh sửa phòng ban
                </h1>

                <p class="text-slate-500 mt-3 text-lg">
                    Cập nhật thông tin và cấu hình hoạt động của phòng ban
                </p>

            </div>

            <!-- STATUS -->
            <div class="inline-flex items-center gap-3 px-5 py-3 rounded-2xl bg-emerald-100 text-emerald-600 font-semibold w-fit">

                <span class="w-3 h-3 rounded-full bg-emerald-500"></span>

                Đang hoạt động

            </div>

        </div>

    </div>

    <!-- CONTENT -->
    <div class="max-w-6xl mx-auto grid grid-cols-12 gap-7">

        <!-- LEFT -->
        <div class="col-span-12 xl:col-span-8">

            <!-- FORM CARD -->
            <div class="bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden">

                <!-- TOP -->
                <div class="px-8 py-6 border-b border-slate-100 bg-slate-50">

                    <div class="flex items-center gap-5">

                        <!-- ICON -->
                        <div class="w-20 h-20 rounded-3xl bg-[#031635]/10 flex items-center justify-center">

                            <span class="material-symbols-outlined text-[#031635] text-[34px]">
                                edit_square
                            </span>

                        </div>

                        <!-- INFO -->
                        <div>

                            <h2 class="text-2xl font-bold text-slate-800">
                                Thông tin phòng ban
                            </h2>

                            <p class="text-slate-500 mt-1">
                                Chỉnh sửa dữ liệu quản lý phòng ban trong hệ thống
                            </p>

                        </div>

                    </div>

                </div>

                <!-- FORM -->
                <form asp-action="Edit">

                    <div class="p-8 space-y-8">

                        <input type="hidden"
                               asp-for="Id" />

                        <!-- VALIDATION -->
                        <div asp-validation-summary="ModelOnly"
                             class="rounded-2xl bg-red-50 border border-red-200 text-red-500 px-5 py-4">
                        </div>

                        <!-- ROOM NAME -->
                        <div>

                            <label class="block text-sm font-semibold text-slate-700 mb-3">

                                Tên phòng ban

                            </label>

                            <div class="relative">

                                <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-slate-400">
                                    apartment
                                </span>

                                <input asp-for="RoomName"
                                       placeholder="Nhập tên phòng ban..."
                                       class="w-full pl-14 pr-5 py-4 rounded-2xl
                                              border border-slate-200
                                              bg-white text-slate-700
                                              shadow-sm
                                              focus:outline-none
                                              focus:ring-4
                                              focus:ring-blue-100
                                              focus:border-[#031635]
                                              transition-all duration-300" />

                            </div>

                            <span asp-validation-for="RoomName"
                                  class="text-red-500 text-sm mt-2 block">
                            </span>

                        </div>

                        <!-- DESCRIPTION -->
                        <div>

                            <label class="block text-sm font-semibold text-slate-700 mb-3">

                                Mô tả phòng ban

                            </label>

                            <textarea rows="4"
                                      placeholder="Nhập mô tả ngắn về phòng ban..."
                                      class="w-full px-5 py-4 rounded-2xl
                                             border border-slate-200
                                             bg-white text-slate-700
                                             shadow-sm
                                             focus:outline-none
                                             focus:ring-4
                                             focus:ring-blue-100
                                             focus:border-[#031635]
                                             transition-all duration-300 resize-none">Phòng ban chịu trách nhiệm quản lý và điều phối hoạt động vận hành liên quan đến shop và nhân sự.</textarea>

                            <p class="text-sm text-slate-400 mt-2">
                                Thông tin mô tả sẽ hiển thị trong hệ thống quản lý.
                            </p>

                        </div>

                       
                       

                        <!-- INFO -->
                        <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-6">

                            <div class="flex items-start gap-4">

                                <!-- ICON -->
                                <div class="w-14 h-14 rounded-2xl bg-[#031635]/10 flex items-center justify-center flex-shrink-0">

                                    <span class="material-symbols-outlined text-[#031635]">
                                        info
                                    </span>

                                </div>

                                <!-- TEXT -->
                                <div>

                                    <h4 class="font-bold text-slate-800 mb-2">
                                        Lưu ý cập nhật
                                    </h4>

                                    <p class="text-sm text-slate-500 leading-relaxed">
                                        Sau khi lưu thay đổi, toàn bộ dữ liệu liên quan đến phòng ban sẽ được cập nhật ngay trong hệ thống.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- FOOTER -->
                    <div class="px-8 py-6 border-t border-slate-100 bg-slate-50 flex items-center justify-end gap-4">

                        <a asp-action="Index"
                           asp-route-id="@Model.Id"
                           class="px-6 py-3 rounded-2xl border border-slate-300
                                  text-slate-700 font-semibold
                                  hover:bg-slate-100
                                  transition-all duration-300">

                            Huỷ

                        </a>

                        <button type="submit"
                                class="px-7 py-3 rounded-2xl
                                       bg-[#031635]
                                       hover:bg-[#0f2d63]
                                       text-white font-semibold
                                       shadow-lg shadow-blue-900/10
                                       hover:-translate-y-0.5
                                       transition-all duration-300
                                       flex items-center gap-2">

                            <span class="material-symbols-outlined text-[20px]">
                                save
                            </span>

                            Lưu thay đổi

                        </button>

                    </div>

                </form>

            </div>

        </div>

        <!-- RIGHT -->
        <div class="col-span-12 xl:col-span-4 space-y-6">

            <!-- QUICK INFO -->
            <div class="bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden">

                <!-- HEADER -->
                <div class="px-6 py-5 border-b border-slate-100 bg-slate-50">

                    <h3 class="text-xl font-bold text-slate-800">
                        Thông tin nhanh
                    </h3>

                </div>

                <!-- BODY -->
                <div class="p-6 space-y-5">

                    <!-- ITEM -->
                    <div class="flex items-center justify-between p-5 rounded-3xl bg-slate-50 border border-slate-100">

                        <div>

                            <p class="text-sm text-slate-500">
                                Mã phòng
                            </p>

                            <h4 class="font-bold text-slate-800 mt-1">
                                ROOM-@Model.Id
                            </h4>

                        </div>

                        <span class="material-symbols-outlined text-[#031635]">
                            badge
                        </span>

                    </div>

                    <!-- ITEM -->
                    <div class="flex items-center justify-between p-5 rounded-3xl bg-emerald-50 border border-emerald-100">

                        <div>

                            <p class="text-sm text-slate-500">
                                Trạng thái
                            </p>

                            <h4 class="font-bold text-emerald-600 mt-1">
                                Hoạt động
                            </h4>

                        </div>

                        <span class="material-symbols-outlined text-emerald-600">
                            check_circle
                        </span>

                    </div>

                    <!-- ITEM -->
                    <div class="flex items-center justify-between p-5 rounded-3xl bg-orange-50 border border-orange-100">

                        <div>

                            <p class="text-sm text-slate-500">
                                Shop trực thuộc
                            </p>

                            <h4 class="font-bold text-orange-500 mt-1">
                                @(Model.Shops?.Count ?? 0)
                            </h4>

                        </div>

                        <span class="material-symbols-outlined text-orange-500">
                            storefront
                        </span>

                    </div>

                </div>

            </div>

            <!-- ACTION -->
            

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}